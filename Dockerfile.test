FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libpq-dev \
    libpqxx-dev \
    libpaho-mqtt-dev \
    libpaho-mqttpp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /telemetry
COPY . .

RUN mkdir build_docker && cmake -DBUILD_ENABLE_GOOGLE_BENCHMARK=ON -B build_docker && cmake --build build_docker

CMD sh -c "./build_docker/bench"
